{
  "name": "@rubinny/desktop",
  "version": "0.12.0",
  "private": true,
  "description": "Rubinny desktop player: the web player in a kiosk window for Windows and Linux (Electron).",
  "license": "AGPL-3.0-only",
  "author": "Diamond Rubinny",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "pnpm build && electron .",
    "e2e": "pnpm build && playwright test",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never",
    "dist:store": "pnpm build && electron-builder --win appx --x64 --arm64 --publish never"
  },
  "build": {
    "appId": "net.rubinny.player",
    "productName": "Rubinny Player",
    "artifactName": "rubinny-player-${version}-${arch}.${ext}",
    "files": [
      "dist/**",
      "static/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "category": "Utility",
      "maintainer": "Diamond Rubinny",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "executableName": "rubinny-player"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true
    },
    "executableName": "rubinny-player",
    "win": {
      "icon": "build/icon.png"
    },
    "appx": {
      "applicationId": "RubinnyScreen",
      "identityName": "DiamondRubinny.Rubinnyscreen",
      "publisher": "CN=A2694403-EEEE-4D3F-80BB-589A9E34AEA9",
      "publisherDisplayName": "Diamond Rubinny",
      "displayName": "Rubinny screen",
      "backgroundColor": "transparent",
      "languages": [
        "he-IL",
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "rubinny-screen-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diamondrubinny/freescreensign.git",
    "directory": "apps/desktop"
  },
  "homepage": "https://github.com/diamondrubinny/freescreensign",
  "desktopName": "rubinny-player.desktop"
}
